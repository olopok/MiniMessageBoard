<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Messages Board</title>
  </head>
  <body>
        <main>
          <h1><%= title %></h1>
          
              <%- include('../partials/navbar', {links: links}) %>
              <ul>
          <% for (let i=0; i<messages.length; i++){%>
              <li>
                <%= messages[i].user %>
                <br>
                <%= messages[i].text%>
                <hr>
              </li>        
              <button>DETAILS</button>
              <%}%>
              </ul>
        </main>
  </body>
</html>
