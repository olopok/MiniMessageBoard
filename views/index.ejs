<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head') %>
  <body>
    <main class="container">
      <header class="header-container">
        <h1><%= title %></h1>
        <%- include('../partials/navbar', {links: links}) %>
      </header>
      <div class="messages-container">
        <ul class="message-wrap">
          <% for (let i = 0; i < messages.length; i++) { %>
          <li class="messages-list">
            <span
              ><strong>USER:</strong>
              <%= messages[i].username %></span
            >
            <p class="msg-wrap"><%= messages[i].text %></p>
            <button class="details-btn">
              <a class="details-link" href="/messages/<%= messages[i].id %>"
                >DETAILS</a
              >
            </button>
          </li>
          <% } %>
        </ul>
      </div>
    </main>
  </body>
</html>
